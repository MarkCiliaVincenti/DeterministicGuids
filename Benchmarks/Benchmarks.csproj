		<PackageReference Include="Elephant.Uuidv5Utilities" Version="1.0.0" />
		<PackageReference Include="Enbrea.GuidFactory" Version="0.14.0" />
		<PackageReference Include="GuidPhantom" Version="0.0.8" />
		<PackageReference Include="NGuid" Version="1.0.0" />
		<PackageReference Include="SequentialGuid" Version="6.2.0" />
		<PackageReference Include="unique" Version="0.0.1" />
		<PackageReference Include="UUIDNext" Version="4.2.4" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\DeterministicGuids\DeterministicGuids.csproj" />
	</ItemGroup>

	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
		<Optimize>true</Optimize>
	</PropertyGroup>

</Project>
